{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var forecast \App\Entity\Forecast[] #}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for forecast in forecast %}
                <li>{{ forecast.date|date('d.m.Y') }}: {{ forecast.temperature }}&deg;C, Ciśnienie-{{ forecast.pressure }} hPa, Wiatr-{{ forecast.wind }} km/h, Wilgotność-{{ forecast.humidity }}</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
